# Copy to .env and change the passwords. .env is git-ignored.
# Without a .env, docker compose uses the local-demo defaults in docker-compose.yml
# (fine on your own laptop, never on a shared server).
POSTGRES_USER=mahros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mahros
PGADMIN_EMAIL=reviewer@example.com
PGADMIN_PASSWORD=change-me
# Host ports
APP_PORT=8080
PGADMIN_PORT=5050
DB_PORT=5432
