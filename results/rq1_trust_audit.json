    },
    "CENSUS_SPIKE": {
      "level": "RED",
      "title": "Implausible jump in patients",
      "explain": "The patient count changed by more than 2.5x in one week, the size of a typing error (an extra zero, or a weekly total entered as a daily average)."
    },
    "BEDS_SPIKE": {
      "level": "RED",
      "title": "Implausible jump in beds",
      "explain": "The number of staffed beds changed by more than 2.5x in one week."
    },
    "PARTIAL_WEEK": {
      "level": "AMBER",
      "title": "Incomplete week",
      "explain": "Fewer than 7 days were reported this week, so the weekly average rests on less data."
    },
    "ARITHMETIC": {
      "level": "AMBER",
      "title": "Totals do not add up",
      "explain": "The reported weekly average does not equal the reported weekly sum divided by the days reported."
    },
    "NOT_REPORTED": {
      "level": "MISSING",
      "title": "Not reported",
      "explain": "No usable patient or bed count was reported this week."
    },
    "SUPPRESSED_SMALL": {
      "level": "MISSING",
      "title": "Withheld (fewer than 4)",
